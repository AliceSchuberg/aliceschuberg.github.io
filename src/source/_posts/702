class Solution {
    public int search(ArrayReader reader, int target) {
        int right = 2;
        int left = 0;
        while (reader.get(right) < target && reader.get(right) != 2147483647) {
            left = right;
            right = right * 2;
        }

        int mid;
        while (left <= right) {
            mid = left + (right-left)/2;
            if (reader.get(mid) > target) {
                 right = mid - 1;
            } else if (reader.get(mid) < target) {
                 left = mid + 1;
            } else {
                 return mid;
            }
        }
        return -1;
    }
}


class Solution {
    public int search(ArrayReader reader, int target) {
        int left = 0;
        int right = 1;
        while (reader.get(right) < target) {
            left = right;
            right <<= 1;
        }
        int mid;
        while (left < right) {
            mid = left + (right-left)/2;
            if (reader.get(mid) >= target) {
                right = mid;
            } else {
